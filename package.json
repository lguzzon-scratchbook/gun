{
  "android": "browser.android.js",
  "author": "Mark Nadal",
  "browser": "browser.js",
  "bugs": {
    "url": "https://github.com/amark/gun/issues"
  },
  "dependencies": {
    "ws": "^7.2.1"
  },
  "description": "A realtime, decentralized, offline-first, graph data synchronization engine.",
  "devDependencies": {
    "aws-sdk": "^2.528.0",
    "emailjs": "^2.2.0",
    "ip": "^1.1.5",
    "mocha": "^6.2.0",
    "uglify-js": "^3.6.0"
  },
  "engines": {
    "node": ">=0.8.4"
  },
  "homepage": "https://github.com/amark/gun#readme",
  "ios": "browser.ios.js",
  "keywords": [
    "gun",
    "gunDB",
    "graph",
    "document",
    "key",
    "value",
    "relational",
    "datastore",
    "database",
    "engine",
    "realtime",
    "decentralized",
    "peer-to-peer",
    "distributed",
    "P2P",
    "OSS",
    "embedded",
    "localstorage",
    "S3"
  ],
  "license": "(Zlib OR MIT OR Apache-2.0)",
  "main": "index.js",
  "name": "gun",
  "optionalDependencies": {
    "@peculiar/webcrypto": "^1.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amark/gun.git"
  },
  "scripts": {
    "build": "node script/build.js",
    "build:unbuild": "npm run build && npm run unbuild:script",
    "check": "bunx @biomejs/biome check --write ./src/*.js ./src/**/*.js package.json",
    "check:file": "bunx @biomejs/biome check --write --max-diagnostics=100",
    "check:test": "clear && npm run check && npm test ; npm run test:reset ; git sti",
    "debug": "node --prof-process --preprocess -j isolate*.log > v8data.json && rm isolate*.log && echo 'drag & drop ./v8data.json into https://mapbox.github.io/flamebearer/'",
    "docker": "hooks/build",
    "e2e": "mocha e2e/distributed.js",
    "flint": "npm run format ; npm run lint",
    "format": "bunx @biomejs/biome format --write ./src/*.js ./src/**/*.js package.json",
    "format:file": "bunx @biomejs/biome format --write",
    "https": "HTTPS_KEY=test/https/server.key HTTPS_CERT=test/https/server.crt npm start",
    "lint": "bunx @biomejs/biome lint --write ./src/*.js ./src/**/*.js package.json",
    "lint:file": "bunx @biomejs/biome lint --write --max-diagnostics=100",
    "minify": "uglifyjs gun.js -o gun.min.js -c -m",
    "prepublishOnly": "npm run unbuild",
    "start": "node --prof examples/http.js",
    "test": "echo 'Did you run PANIC holy-grail, 1~X, on-recover, etc.?' && npm run test:reset && npm run build && mocha --bail",
    "test:reset": "(rm -rf radatatest/ >/dev/null 2>&1 || true)",
    "testsea": "mocha test/sea/sea.js",
    "unbuild": "npm run unbuild:script && npm run minify",
    "unbuild:script": "mv src/footer.js . && node script/unbuild.js && mv footer.js src/ && npm run check",
    "unbuildMeta": "node script/unbuild.js lib/meta",
    "unbuildSea": "node script/unbuild.js sea"
  },
  "tsd": {
    "directory": "types"
  },
  "types": "index.d.ts",
  "version": "0.2020.1239"
}
